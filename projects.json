    {
      "id": "PRJ-006-SHOWREEL",
      "section": "motion_graphics",
      "title": "SHOWREEL 2024 // VFX & MOTION",
      "client": "Self",
      "status": "OPERATIONAL",
      "type": "Showreel",
      "media": {
        "type": "video_iframe",
        "url": "https://www.youtube.com/embed/dMwpMWZafXs"
      },
      "content": {
        "html_body": "<div class=\"cs-block\" style=\"margin-top: 2rem;\"><h3 class=\"cs-heading\">[ VFX Artist &amp; AI Specialist | Freelancer (Current) ]</h3><p style=\"margin-bottom: 0.5rem;\">Freelance VFX and compositing for commercial and experimental projects.</p><p style=\"margin-bottom: 0.5rem;\"><strong>AI-augmented production:</strong> developing hybrid pipelines for music videos and animation, utilizing AI for asset generation (backgrounds, textures) and compositing for final integration.</p><p style=\"margin-bottom: 0.5rem;\"><strong>Key projects:</strong> full-cycle music videos (AI/VFX) and an animated podcast series using AI-assisted workflows.</p><p><strong>Stack:</strong> ComfyUI // AI Tools // After Effects // Nuke</p></div><div class=\"cs-block\" style=\"margin-top: 1rem;\"><h3 class=\"cs-heading\">[ VFX Artist / Compositor | Screen Post Productions (2023-2024) ]</h3><p>Served as a compositor in a fast-paced broadcast environment, focusing on commercials and TV series.</p><ul class=\"cs-list\" style=\"margin-top: 1rem;\"><li><strong>Toolset Focus:</strong> Maximized Adobe After Effects capabilities for complex \"invisible VFX\": wire/rig removal, cosmetic cleanup, and screen replacements.</li><li>Managed advanced chroma keying and integration of talent into virtual sets under tight deadlines.</li></ul></div><div class=\"cs-block\" style=\"margin-top: 1rem;\"><h3 class=\"cs-heading\">[ Junior VFX Artist / Compositor | Broadcast Studio ]</h3><p>Daily VFX work in a Nuke-based pipeline, building strong node-based compositing skills.</p><ul class=\"cs-list\" style=\"margin-top: 1rem;\"><li>Rotoscoping, tracking, multipass CG compositing.</li><li>Close collaboration with 3D departments for render pass integration into live-action plates.</li><li>Delivered shots for major clients such as Partner, Bank Discount, and Super-Pharm, meeting broadcast-quality standards.</li></ul></div><div class=\"cs-block\" style=\"margin-top: 1rem;\"><h3 class=\"cs-heading\">[ Feature Films &amp; Music Videos ]</h3><ul class=\"cs-list\" style=\"margin-top: 1rem;\"><li><strong>Ulli-Kale's Large Snake</strong> (Feature film, dir. Aleksey Fedorchenko, 2022) — Junior Compositor, part of a team</li><li><strong>The Last Darling Bulgaria</strong> (Feature film, dir. Aleksey Fedorchenko, 2021) — Junior Compositor, part of a team</li><li><strong>Love Is Not Politics</strong> (Music video, 2021) — Junior Compositor</li></ul></div>"
      },
      "metadata": {
        "duration": "00:57",
        "nodes_active": "MAX"
      }
    },
