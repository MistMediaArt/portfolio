      "id": "PRJ-APP-001",
      "section": "apps",
      "template": "case_study",
      "title": "QPROMPTER // PWA",
      "client": "Internal",
      "status": "DEPLOYED",
      "type": "Web Application",
      "media": {
        "type": "image",
        "fallback_image": "Images/QPrompter/Qprompter_laptop.png",
        "gallery": [
          "Images/QPrompter/Qprompter_laptop.png",
          "Images/QPrompter/I_need_this_exact_interface_202605021912.jpeg"
        ]
      },
      "content": {
        "what_it_is": "Local-first prompt library with image support and AI-assisted templates. QPrompter is a browser-based tool for collecting, organising, and reusing prompts for generative AI models. Everything stays on your device – no cloud, no server, no data collection.",
        "features": {
          "Prompt management": "Group prompts by categories (custom colours and icons), add tags, mark favourites or pin important ones. Search, combined filters, and saved filter sets.",
          "Image Vault": "A built-in image store that keeps your visual references. Import images from files or paste from the clipboard.",
          "Board Builder": "Arrange selected images from the Vault into a custom grid. Adjust columns, rows, gap, canvas size and background colour. Export to PNG/JPG.",
          "AI processing": "Use DeepSeek or Gemini APIs to format text, convert to template with {{variables}}, or strip formatting. Customisable system presets.",
          "Import / Export": "Save your entire library as JSON or as a ZIP archive that includes all linked images.",
          "Interface": "Works with mouse and touch. Dark theme, adjustable card density, and responsive layout."
        },
        "who_its_for": [
          "Artists using reference images alongside their prompts.",
          "People who manage dozens of prompts and need fast search.",
          "Developers who want full control over their data without vendor lock-in."
        ],
        "tech_stack": [
          "Vanilla JS",
          "IndexedDB",
          "File API",
          "Offline First"
        ],
        "links": {
          "Live App": "https://qprompter-codex-v1.onrender.com/",
          "GitHub": "https://github.com/MistMediaArt/QPrompter_Codex"
        }
      },
